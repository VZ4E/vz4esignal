# Supabase (public — safe for client-side)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-public-key>

# Supabase (secret — server-side only)
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# RapidAPI (server-side only)
RAPIDAPI_KEY=<your-rapidapi-key>
RAPIDAPI_TIKTOK_HOST=tiktok-api23.p.rapidapi.com

# Transcript24 via RapidAPI (server-side only)
# Host is set in code: transcript24.p.rapidapi.com

# Perplexity AI (server-side only)
PERPLEXITY_API_KEY=<your-perplexity-api-key>
